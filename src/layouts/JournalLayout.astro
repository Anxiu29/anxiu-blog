---
import { ClientRouter } from "astro:transitions";
import AuthoringBlocks from "@/components/authoring/AuthoringBlocks.astro";
import BackgroundSettings from "@/components/journal/BackgroundSettings.astro";
import BlogHeader from "@/components/journal/BlogHeader.astro";
import Icon from "@/components/journal/Icon.astro";
import JournalMusic from "@/components/journal/JournalMusic.astro";
import MobileNavigation from "@/components/journal/MobileNavigation.astro";
import SearchPanel from "@/components/journal/SearchPanel.astro";
import SiteBanner from "@/components/journal/SiteBanner.astro";
import { siteConfig } from "@/config/siteConfig";
import { getJournalSearchIndex } from "@/data/journal-search";
import "@/styles/journal.css";
import "@/styles/sky-blog.css";
import "@/styles/blog-discovery.css";
import "@/styles/editorial.css";
import "@/styles/browsing.css";
import "@/styles/reference-pass.css";
import "@/styles/background-settings.css";
import "@/styles/journal-shell.css";
import "@/styles/journal-music.css";
import "@rehype-callouts-theme";
import "@/styles/journal-article.css";
import "@/styles/journal-content-polish.css";
import "@/styles/brand-identity.css";
import "@/styles/journal-mobile.css";

interface Props {
	title?: string;
	description?: string;
	active?: string;
	noindex?: boolean;
	article?: boolean;
	musicPage?: boolean;
	image?: string;
	imageAlt?: string;
}
const {
	title,
	description = siteConfig.description,
	active = "文章",
	noindex = false,
	article = false,
	musicPage = false,
	image = "/images/backgrounds/anime-live-poster.webp",
	imageAlt = "安秀的开发手记",
} = Astro.props;
const { version: searchVersion, articlePaths } = await getJournalSearchIndex();
const canonical = new URL(Astro.url.pathname, siteConfig.site_url);
---
<!doctype html>
<html lang="zh-CN"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
<title>{title?title+' - 安秀':'安秀 · 技术、工具与记录'}</title>
<meta name="theme-color" content="#edf1f6"/><meta name="description" content={description}/><meta name="author" content="安秀"/><meta name="color-scheme" content="light dark"/>
{noindex&&<meta name="robots" content="noindex,follow"/>}
<link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon/site-clover.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon/site-clover-32.png"/><link rel="apple-touch-icon" sizes="180x180" href="/favicon/site-clover-180.png"/><link rel="alternate" type="application/rss+xml" title="安秀的文章" href="/rss.xml"/>
<meta property="og:title" content={title?title+' - 安秀':'安秀 · 技术、工具与记录'}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article ? "article" : "website"}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="安秀的开发手记"/><meta property="og:image" content={new URL(image, siteConfig.site_url)}/><meta property="og:image:alt" content={imageAlt}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title?title+' - 安秀':'安秀 · 技术、工具与记录'}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image, siteConfig.site_url)}/><meta name="twitter:image:alt" content={imageAlt}/>
<script is:inline>try{const dark=localStorage.getItem('anxiu-theme')==='dark'||(!localStorage.getItem('anxiu-theme')&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.classList.toggle('dark',dark);document.documentElement.dataset.theme=dark?'one-dark-pro':'one-light';}catch{}</script>
<script is:inline>try{document.documentElement.dataset.postView=localStorage.getItem("anxiu-post-view-v1")==="compact"?"compact":"cards";}catch{document.documentElement.dataset.postView="cards";}</script>
<ClientRouter fallback="swap"/>
<slot name="head"/></head><body id="top" data-music-page={String(musicPage)} class:list={['hyde-shell',{'home-page':active==='首页','post-page':article,'music-page':musicPage}]}>
<a class="skip-link" href="#main">跳到正文</a>
<BlogHeader active={active}/>
<SiteBanner title={title} description={description} home={active==='首页'} article={article}/>
<main id="main" class="site-main" data-pagefind-body={!noindex || undefined}><span hidden data-pagefind-meta="title">{title || '安秀的开发手记'}</span>{musicPage && <JournalMusic embedded/>}<slot/></main>
<footer class="site-footer"><div class="footer-top"><div class="footer-about"><a href="/" class="footer-name"><img class="brand-clover" src="/branding/site-clover.svg" width="128" height="128" alt="" decoding="async"/>安秀</a><p>前端开发、设备联调，<br/>还有一些自己做的小工具。</p><a class="footer-github" href="https://github.com/Anxiu29" target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow"/></a></div><nav aria-label="文章与阅读"><h2>阅读</h2><a href="/archive/">全部文章</a><a href="/series/">专题阅读</a><a href="/saved/">我的收藏</a><a href="/categories/">文章分类</a><a href="/tags/">全部标签</a></nav><nav aria-label="工具与项目"><h2>动手试试</h2><a href="/tools/">开发工具</a><a href="/projects/">个人作品</a><a href="/todo/">我的待办</a><a href="/projects/fog-town/">雾镇夜行</a><a href="/tools/hid/">WebHID 调试</a></nav><nav aria-label="更多博客入口"><h2>保持联系</h2><a href="/about/">关于安秀</a><a href="/photos/">私人相册</a><a href="/music/">听点音乐</a><a href="/updates/">开发动态</a><a href="/friends/">站点收藏</a><a href="/rss/">RSS 订阅</a></nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} 安秀</span><div class="credits">Powered by <a href="https://astro.build/">Astro</a> &amp; <a href="https://github.com/CuteLeaf/Firefly">Firefly</a></div><a href="#top">回到顶部 ↑</a></div></footer>
<div id="journal-utilities" style="display: contents" transition:persist="journal-utilities">
<a href="#top" id="back-top" class="back-top" aria-label="返回顶部" hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 14 6-6 6 6M12 8v12"/></svg><span data-scroll-percent aria-hidden="true">0%</span></a>
<dialog id="search-dialog" aria-labelledby="search-title"><form method="dialog" class="search-top"><label id="search-title" for="site-search">搜索文章和工具</label><button class="icon-button" aria-label="关闭搜索"><Icon name="close"/></button></form><SearchPanel dialog/><div class="search-bottom"><span>Esc 关闭 · Ctrl / ⌘ K 搜索</span><a href="/search/" data-full-search>打开完整搜索 →</a></div></dialog>
<MobileNavigation active={active}/>
<BackgroundSettings/>
<AuthoringBlocks/>
</div>
{!musicPage && <JournalMusic/>}
<div id="saved-article-catalog" hidden data-paths={JSON.stringify(articlePaths)}></div>
<div id="search-data" hidden data-source={'/api/search-index.json?v='+searchVersion}></div>
<script>
import {initializeJournalSearch} from '@/scripts/journal-search';
initializeJournalSearch();
const dialog=document.querySelector<HTMLDialogElement>('#search-dialog');
const input=document.querySelector<HTMLInputElement>('#site-search');
function open(){if(!dialog||dialog.open)return;document.querySelector<HTMLDialogElement>('#appearance-dialog')?.close();document.querySelector<HTMLDialogElement>('#mobile-navigation')?.close();const player=document.querySelector<HTMLElement>('#music-panel');if(player?.matches(':popover-open'))player.hidePopover();dialog.showModal();input?.dispatchEvent(new Event('input'));input?.focus();}
document.querySelector('#open-search')?.addEventListener('click',open);
dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
document.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open();}});
const themeButton=document.querySelector<HTMLButtonElement>('#theme-toggle');function themeLabel(){themeButton?.setAttribute('aria-label',document.documentElement.classList.contains('dark')?'切换到浅色模式':'切换到深色模式');}themeLabel();themeButton?.addEventListener('click',()=>{const dark=document.documentElement.classList.toggle('dark');document.documentElement.dataset.theme=dark?'one-dark-pro':'one-light';try{localStorage.setItem('anxiu-theme',dark?'dark':'light');}catch{}themeLabel();});
</script>
<script>
import { initializeJournalPage, prepareJournalSwap } from '@/scripts/journal-navigation';
document.addEventListener('astro:page-load', initializeJournalPage);
document.addEventListener('astro:before-swap', prepareJournalSwap);
</script></body></html>
