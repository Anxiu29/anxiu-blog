---
import { backgroundImages, backgroundVideos } from "@/data/background-images";
import { BACKGROUND_PHOTO_TYPES } from "@/scripts/background-storage";
import Icon from "./Icon.astro";
import "@/styles/journal-display.css";

const modes = [
	{ value: "image", title: "图片壁纸", icon: "image" },
	{ value: "video", title: "动态壁纸", icon: "play" },
	{ value: "color", title: "自选颜色", icon: "palette" },
];
---
<div id="site-wallpaper" aria-hidden="true" hidden><div class="wallpaper-layer"><video id="site-wallpaper-video" class="wallpaper-video" poster={backgroundVideos[0].poster} preload="none" muted loop playsinline disablepictureinpicture tabindex="-1" hidden></video></div><div class="wallpaper-shade"></div></div>
<dialog id="appearance-dialog" class="appearance-dialog" aria-labelledby="appearance-title" aria-describedby="appearance-description">
 <div class="appearance-heading"><div><h2 id="appearance-title">外观设置</h2><p id="appearance-description">选择文章显示方式和喜欢的壁纸。</p></div><button type="button" id="close-appearance" class="icon-button" aria-label="关闭外观设置" autofocus><Icon name="close"/></button></div>
 <div class="appearance-body">
 <section id="post-view-settings" class="appearance-section" aria-labelledby="post-view-heading"><h3 id="post-view-heading">文章显示</h3><div class="post-view-options" role="radiogroup" aria-label="首页与归档的文章显示方式"><label><input type="radio" name="post-view" value="cards" checked/><span>封面卡片</span></label><label><input type="radio" name="post-view" value="compact"/><span>紧凑列表</span></label></div><p class="appearance-help">用于首页和归档。紧凑列表隐藏封面，保留标题、摘要和标签。</p><p class="post-view-status" data-post-view-status role="status" aria-live="polite">偏好保存在此浏览器。</p><button type="button" class="appearance-text-button" data-reset-post-view>恢复封面卡片</button></section>
 <form id="appearance-form"><fieldset id="appearance-fields"><legend class="sr-only">背景设置</legend>
 <div class="appearance-section"><h3>背景样式</h3><div class="background-options" role="radiogroup" aria-label="背景样式">{modes.map(mode=><label><input type="radio" name="background-mode" value={mode.value} checked={mode.value==='image'}/><span class={'background-swatch swatch-'+mode.value} aria-hidden="true"><Icon name={mode.icon}/></span><span>{mode.title}</span></label>)}</div></div>
 <div class="appearance-section" data-background-section="image"><div class="appearance-label-row"><h3>图片壁纸</h3><span class="appearance-gallery-note">点选即可使用</span></div><div class="wallpaper-gallery" role="group" aria-label="图片壁纸">{backgroundImages.map(image=><button type="button" data-wallpaper={image.id} aria-pressed="false" aria-label={'使用'+image.title+'背景'}><img src={image.thumbnail} width="480" height="270" alt="" loading="lazy" decoding="async"/><span>{image.title}</span><span class="wallpaper-selected" aria-hidden="true"><Icon name="check"/></span></button>)}</div></div>
 <div class="appearance-section" data-background-section="video" hidden><div class="appearance-label-row"><h3>动态壁纸</h3><span class="appearance-gallery-note">静音 · 循环播放</span></div><div class="wallpaper-movies" role="group" aria-label="动态壁纸">{backgroundVideos.map(movie=><button type="button" class="wallpaper-motion-card" data-video-wallpaper={movie.id} aria-pressed="false" aria-label={'使用'+movie.title+'动态壁纸'}><img src={movie.thumbnail} width="480" height="270" alt="" loading="lazy" decoding="async"/><span class="motion-card-caption"><span><Icon name="play"/>{movie.title}</span><small>{movie.duration}</small></span><span class="wallpaper-selected" aria-hidden="true"><Icon name="check"/></span></button>)}</div><button type="button" id="toggle-background-video" class="appearance-playback" hidden>暂停动态壁纸</button><p class="appearance-help motion-help">选中后静音循环播放，可随时暂停；减少动态效果或节省流量时先显示静态封面。</p><div class="local-video-upload"><div class="appearance-label-row"><h3>本地动态壁纸</h3><div class="appearance-photo-actions"><button type="button" id="use-background-video" class="appearance-text-button" hidden>使用此视频</button><button type="button" id="remove-background-video" class="appearance-text-button" disabled>删除视频</button></div></div><button type="button" id="choose-background-video" class="appearance-upload"><Icon name="play"/><span>选择本地 MP4 视频</span><Icon name="arrow"/></button><input type="file" id="background-video-file" accept="video/mp4,.mp4" hidden/><p class="appearance-help">支持 MP4，最大 100 MB，推荐 H.264 编码。静音循环，仅保存在此浏览器，不会上传。</p><p id="background-video-name" class="background-photo-name">尚未选择视频</p></div></div>
 <div class="appearance-section appearance-color-row" data-background-section="color" hidden><label for="background-color">自定义底色<small>选择喜欢的背景颜色</small></label><input type="color" id="background-color" value="#9dcdf0"/><output for="background-color" id="background-color-value">#9dcdf0</output></div>
 <div class="appearance-section" data-background-section="image"><div class="appearance-label-row"><h3>本地背景图片</h3><div class="appearance-photo-actions"><button type="button" id="use-background-photo" class="appearance-text-button" hidden>使用此图</button><button type="button" id="remove-background-photo" class="appearance-text-button" disabled>删除图片</button></div></div><button type="button" id="choose-background-photo" class="appearance-upload"><Icon name="image"/><span>选择本地图片</span><Icon name="arrow"/></button><input type="file" id="background-photo" accept={BACKGROUND_PHOTO_TYPES.join(",")} hidden/><p class="appearance-help">支持 GIF、动态 WebP、APNG，以及 JPG、PNG、AVIF，最大 10 MB。动图保留动画，仅保存在此浏览器，不会上传。</p><p id="background-photo-name" class="background-photo-name">尚未选择图片</p></div>
 <div class="appearance-section appearance-adjustments"><div><label for="background-overlay">遮罩深浅<output id="background-overlay-value" for="background-overlay">40%</output></label><input id="background-overlay" type="range" min="20" max="95" value="40"/><p class="appearance-help">数值越高，背景越淡，文字越清楚。</p></div><div data-background-section="image video"><label for="background-blur">壁纸模糊<output id="background-blur-value" for="background-blur">0 px</output></label><input id="background-blur" type="range" min="0" max="20" value="0"/></div></div>
 <p id="appearance-status" class="appearance-status" role="status" aria-live="polite">设置会保存在此浏览器。</p><button type="button" id="reset-background" class="appearance-reset">重置背景</button>
 </fieldset></form>
 </div>
</dialog>
<script>
import {initializeAppearance} from '@/scripts/appearance';
initializeAppearance();
import { initializePostView } from '@/scripts/post-view';
initializePostView();
</script>
