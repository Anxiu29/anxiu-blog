---
import Icon from './Icon.astro';
import {backgroundImages,backgroundVideo} from '@/data/background-images';
const modes=[{value:'image',title:'图片壁纸',icon:'image'},{value:'video',title:'动态壁纸',icon:'play'},{value:'color',title:'自选颜色',icon:'palette'}];
---
<div id="site-wallpaper" aria-hidden="true" hidden><div class="wallpaper-layer"><video id="site-wallpaper-video" class="wallpaper-video" poster={backgroundVideo.poster} preload="none" muted loop playsinline disablepictureinpicture tabindex="-1" hidden></video></div><div class="wallpaper-shade"></div></div>
<dialog id="appearance-dialog" class="appearance-dialog" aria-labelledby="appearance-title" aria-describedby="appearance-description">
 <div class="appearance-heading"><div><h2 id="appearance-title">外观设置</h2><p id="appearance-description">换一张喜欢的壁纸。</p></div><button type="button" id="close-appearance" class="icon-button" aria-label="关闭外观设置" autofocus><Icon name="close"/></button></div>
 <form id="appearance-form"><fieldset id="appearance-fields"><legend class="sr-only">背景设置</legend>
 <div class="appearance-section"><h3>背景样式</h3><div class="background-options" role="radiogroup" aria-label="背景样式">{modes.map(mode=><label><input type="radio" name="background-mode" value={mode.value} checked={mode.value==='image'}/><span class={'background-swatch swatch-'+mode.value} aria-hidden="true"><Icon name={mode.icon}/></span><span>{mode.title}</span></label>)}</div></div>
 <div class="appearance-section"><div class="appearance-label-row"><h3>图片壁纸</h3><span class="appearance-gallery-note">点选即可使用</span></div><div class="wallpaper-gallery" role="group" aria-label="图片壁纸">{backgroundImages.map(image=><button type="button" data-wallpaper={image.id} aria-pressed="false" aria-label={'使用'+image.title+'背景'}><img src={image.thumbnail} width="480" height="270" alt="" loading="lazy" decoding="async"/><span>{image.title}</span><span class="wallpaper-selected" aria-hidden="true"><Icon name="check"/></span></button>)}</div></div>
 <div class="appearance-section"><div class="appearance-label-row"><h3>动态壁纸</h3><span class="appearance-gallery-note">静音 · 循环播放</span></div><button type="button" class="wallpaper-motion-card" data-video-wallpaper aria-pressed="false" aria-label={'使用'+backgroundVideo.title+'动态壁纸'}><img src={backgroundVideo.thumbnail} width="480" height="270" alt="" loading="lazy" decoding="async"/><span class="motion-card-caption"><span><Icon name="play"/>{backgroundVideo.title}</span><small>约 20 秒 · 1080p</small></span><span class="wallpaper-selected" aria-hidden="true"><Icon name="check"/></span></button><button type="button" id="toggle-background-video" class="appearance-playback" hidden>暂停动态壁纸</button><p class="appearance-help motion-help">仅选中后加载。减少动态效果时先显示静态封面。</p></div>
 <div class="appearance-section appearance-color-row"><label for="background-color">自定义底色<small>选色后切换为自选颜色</small></label><input type="color" id="background-color" value="#9dcdf0"/><output for="background-color" id="background-color-value">#9dcdf0</output></div>
 <div class="appearance-section"><div class="appearance-label-row"><h3>本地背景图片</h3><div class="appearance-photo-actions"><button type="button" id="use-background-photo" class="appearance-text-button" hidden>使用此图</button><button type="button" id="remove-background-photo" class="appearance-text-button" disabled>删除图片</button></div></div><button type="button" id="choose-background-photo" class="appearance-upload"><Icon name="image"/><span>选择本地图片</span><Icon name="arrow"/></button><input type="file" id="background-photo" accept="image/png,image/jpeg,image/webp,image/avif" hidden/><p class="appearance-help">JPG、PNG、WebP、AVIF，最大 10 MB。仅保存在此浏览器，不会上传。</p><p id="background-photo-name" class="background-photo-name">尚未选择图片</p></div>
 <div class="appearance-section appearance-adjustments"><div><label for="background-overlay">遮罩深浅<output id="background-overlay-value" for="background-overlay">40%</output></label><input id="background-overlay" type="range" min="20" max="95" value="40"/><p class="appearance-help">数值越高，背景越淡，文字越清楚。</p></div><div><label for="background-blur">壁纸模糊<output id="background-blur-value" for="background-blur">0 px</output></label><input id="background-blur" type="range" min="0" max="20" value="0"/></div></div>
 <p id="appearance-status" class="appearance-status" role="status" aria-live="polite">设置会保存在此浏览器。</p><button type="button" id="reset-background" class="appearance-reset">重置背景</button>
 </fieldset></form>
</dialog>
<script>
import {initializeAppearance} from '@/scripts/appearance';
initializeAppearance();
</script>
