---
import { tools } from "@/data/tools";
import Icon from "./Icon.astro";

const shortcuts = tools.filter((tool) =>
	["hid", "workbench", "align"].includes(tool.id),
);
---
<section class="home-discovery" aria-label="博客介绍与作品">
 <div class="wallpaper-welcome">
  <div class="welcome-copy"><h1 aria-label="前端开发与设备联调">前端开发<span>与设备联调</span></h1><p>记录键鼠网页驱动、设备协议，<br/>以及自己做的工具和项目。</p><div class="welcome-actions"><a class="welcome-primary" href="/archive/">浏览文章 <Icon name="arrow"/></a><a href="/projects/">查看作品 <Icon name="arrow"/></a></div><div class="welcome-topics"><span>WebHID</span><span>Vue</span><span>TypeScript</span></div></div>
  <button type="button" class="welcome-wallpaper" data-open-wallpaper><Icon name="palette"/><span>更换壁纸</span></button>
 </div>
 <div class="home-featured" aria-label="作品选读">
  <a class="wallpaper-project" href="/posts/anxiu-demo/"><img src="/images/projects/anxiu-interface.jpg" width="1280" height="800" alt="Anxiu 演示模式的键盘改键界面"/><div><h2>Anxiu 键鼠网页驱动</h2><p>改键、宏与设备配置，也可以先试试演示模式。</p></div><Icon name="arrow"/></a>
  <a class="wallpaper-project" href="/projects/fog-town/"><img src="/images/projects/fog-town.jpg" width="1280" height="800" alt="雾镇夜行的雨夜古镇游戏界面"/><div><h2>雾镇夜行</h2><p>用 Three.js 做的雨夜古镇探索小游戏。</p></div><Icon name="arrow"/></a>
 </div>
 <nav class="home-toolbelt" aria-label="常用开发工具">{shortcuts.map(tool=><a href={tool.href}><span class="toolbelt-icon"><Icon name={tool.icon}/></span><span class="toolbelt-copy"><strong>{tool.title}</strong><span>{tool.description}</span></span><Icon name="arrow" class="toolbelt-arrow"/></a>)}</nav>
</section>
<script>
document.querySelector('[data-open-wallpaper]')?.addEventListener('click',()=>document.querySelector<HTMLButtonElement>('#open-appearance')?.click());
</script>
