---
import Icon from "./Icon.astro";

interface Props {
	dialog?: boolean;
}
const { dialog = false } = Astro.props;
const prefix = dialog ? "site" : "page";
---
<div class:list={['search-panel',{'search-page-panel':!dialog}]} data-site-search data-search-page={!dialog||undefined}>
  <form role="search" data-search-form>
    {!dialog&&<label class="sr-only" for={prefix+'-search'}>搜索全站</label>}
    <div class="search-input-wrap"><Icon name="search"/><input id={prefix+'-search'} class="site-search-input" name="q" type="search" placeholder="搜索文章、工具或作品…" autocomplete="off" aria-describedby={prefix+'-search-status '+prefix+'-search-help'} aria-controls={dialog?'search-results':'page-search-results'}/></div>
  </form>
  <div class="search-options"><label>搜索范围<select data-search-kind><option value="">全部内容</option><option value="文章">文章</option><option value="工具">工具</option><option value="作品">作品</option><option value="页面">页面</option></select></label><button type="button" class="j-button subtle" data-search-retry hidden>重新加载</button></div>
  <p class="search-help" id={prefix+'-search-status'} role="status" aria-live="polite" data-search-status>输入关键词，搜索文章全文、工具和作品。</p>
  <p class="search-keyboard-help" id={prefix+'-search-help'}>方向键选择 · Enter 打开 · Tab 逐项浏览</p>
  <ul class="search-results" id={dialog?'search-results':'page-search-results'} data-search-results></ul>
  <noscript><p class="search-help">全文搜索需要 JavaScript，也可以从<a href="/archive/">文章归档</a>或<a href="/tools/">工具箱</a>继续浏览。</p></noscript>
</div>
