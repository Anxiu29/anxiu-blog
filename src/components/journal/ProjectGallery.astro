---
import Icon from './Icon.astro';
import TodoPreview from './TodoPreview.astro';
import {projects,projectKinds} from '@/data/projects';
---
<section class="project-directory" aria-label="作品目录"><form class="project-controls" id="project-filters" role="search"><label class="sr-only" for="project-query">搜索作品</label><div class="project-query-wrap"><Icon name="search"/><input id="project-query" type="search" placeholder="搜索项目、功能或技术" name="q"/></div><button type="reset">重置</button><div class="project-kind-tabs" role="group" aria-label="作品类型">{projectKinds.map(kind=><button type="button" data-project-kind={kind.id} aria-pressed={kind.id===''?'true':'false'}>{kind.label}<small>{projects.filter(p=>!kind.id||p.kind===kind.id).length}</small></button>)}</div></form><p class="project-results" role="status" aria-live="polite" id="project-results">共 {projects.length} 个作品</p><div class="project-gallery">{projects.map(project=><article class={'portfolio-card portfolio-'+project.id} data-project-kind-value={project.kind} data-project-card data-project-text={[project.title,project.description,project.status,...project.tech].join(' ')}><div class="portfolio-visual">{'image' in project?<a href={project.href} tabindex="-1" aria-hidden="true"><img src={project.image} alt={project.imageAlt} width="1280" height="800" loading="lazy"/></a>:project.id==='todo'?<TodoPreview/>:<div class="portfolio-note"><Icon name={project.icon||'keyboard'}/><strong>{project.title}</strong><ul>{'features' in project&&project.features?.map(feature=><li>{feature}</li>)}</ul></div>}</div><div class="portfolio-copy"><div class="portfolio-heading"><h2><a href={project.href}>{project.title}</a></h2><span class:list={['project-status',{'in-progress':project.status==='开发中'}]}>{project.status}</span></div><p>{project.description}</p><ul class="portfolio-tech" aria-label={project.title+'的技术'}>{project.tech.map(tech=><li>{tech}</li>)}</ul><div class="portfolio-actions"><a href={project.href}>{project.action} <Icon name="arrow"/></a>{'launch' in project&&<a href={project.launch} target="_blank" rel="noopener noreferrer">{project.launchLabel} <Icon name="arrow"/></a>}</div></div></article>)}</div><p id="project-empty" class="empty-state" hidden>没有匹配的作品，换个关键词或重置筛选。</p></section>
<script>
const form=document.querySelector<HTMLFormElement>('#project-filters');const input=document.querySelector<HTMLInputElement>('#project-query');const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-project-kind]')];const cards=[...document.querySelectorAll<HTMLElement>('[data-project-card]')];const status=document.querySelector('#project-results');const empty=document.querySelector<HTMLElement>('#project-empty');const params=new URLSearchParams(location.search);let kind=params.get('kind')||'';if(input)input.value=params.get('q')||'';
function filter(){const terms=(input?.value.trim().toLocaleLowerCase()||'').split(/\s+/).filter(Boolean);let count=0;cards.forEach(card=>{const visible=(!kind||card.dataset.projectKindValue===kind)&&terms.every(term=>(card.dataset.projectText||'').toLocaleLowerCase().includes(term));card.hidden=!visible;if(visible)count++;});buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.projectKind===kind)));if(status)status.textContent='共 '+count+' 个作品';if(empty)empty.hidden=count>0;const url=new URL(location.href);url.searchParams.delete('q');url.searchParams.delete('kind');if(input?.value.trim())url.searchParams.set('q',input.value.trim());if(kind)url.searchParams.set('kind',kind);history.replaceState(null,'',url);}
input?.addEventListener('input',filter);buttons.forEach(b=>b.addEventListener('click',()=>{kind=b.dataset.projectKind||'';filter();}));form?.addEventListener('submit',e=>e.preventDefault());form?.addEventListener('reset',()=>{kind='';requestAnimationFrame(filter);});filter();
</script>
