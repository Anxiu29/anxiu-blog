---
import Icon from "./Icon.astro";
import "@/styles/journal-reading-completion.css";

interface Props {
	url: string;
}
const { url } = Astro.props;
---
<div class="reading-progress" aria-hidden="true"><span id="reading-progress-fill"></span></div>
<div data-share-widget>
  <div class="reading-tools" aria-label="阅读工具">
    <div><label for="reading-size">字号</label><select id="reading-size"><option value="default">标准</option><option value="large">稍大</option><option value="xlarge">大字</option></select></div>
    <span class="reading-percent" id="reading-percent" aria-label="正文阅读进度">0%</span>
    <button type="button" id="toggle-reading-focus" aria-pressed="false">专注阅读</button>
    <button id="copy-article-link" type="button" data-article-share data-url={url}>复制链接 <Icon name="arrow"/></button>
    <button type="button" data-save-article={new URL(url).pathname} aria-pressed="false"><Icon name="book"/><span data-save-label>收藏文章</span></button>
    <span class="saved-article-status" data-save-status role="status" aria-live="polite"></span>
    <span id="article-copy-status" class="reading-copy-status" data-share-status role="status" aria-live="polite"></span>
  </div>
  <div id="article-share-fallback" class="article-share-fallback" data-share-fallback hidden>
    <label for="article-share-url">复制下方文章地址</label><input id="article-share-url" data-share-address value={url} readonly/>
    <button type="button" data-share-dismiss>收起地址</button>
  </div>
</div>
<div class="reading-resume" data-reading-resume hidden>
  <div><p>上次读到 <strong data-resume-percent></strong></p><small>进度仅保存在这个浏览器</small></div>
  <div class="reading-resume-actions"><button type="button" data-resume-continue>继续阅读 <span aria-hidden="true">→</span></button><button type="button" data-resume-clear>清除记录</button></div>
</div>
<button type="button" id="exit-reading-focus" class="reading-exit" hidden>退出专注 <span aria-hidden="true">Esc</span></button>
<script>
import { initializeReadingResume } from "@/scripts/reading-resume";
import { initializeArticleSharing, initializeReadingTools } from "@/scripts/journal-reading";
initializeReadingTools();
initializeArticleSharing();
initializeReadingResume();
</script>
