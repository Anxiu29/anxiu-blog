---
import Icon from "./Icon.astro";
---
<dialog id="article-image-viewer" class="article-image-viewer" aria-label="查看文章图片" aria-describedby="article-viewer-help">
  <header class="image-viewer-header"><span id="article-viewer-count" role="status" aria-live="polite"></span><button type="button" id="article-viewer-close" class="image-viewer-close" aria-label="关闭图片"><Icon name="close"/></button></header>
  <figure id="article-viewer-figure"><img id="article-viewer-image" alt=""/><p id="article-viewer-error" role="status" hidden>这张图片暂时无法加载。可以切换其他图片，或关闭后重试。</p><figcaption id="article-viewer-caption"></figcaption></figure>
  <nav id="article-viewer-navigation" class="image-viewer-navigation" aria-label="切换文章图片"><button type="button" id="article-viewer-prev"><Icon name="left"/>上一张</button><button type="button" id="article-viewer-next">下一张<Icon name="right"/></button></nav>
  <p id="article-viewer-help">左右方向键切换 · Esc 或点击空白处关闭</p>
</dialog>
<script>
import { initializeArticleImages } from '@/scripts/journal-images';
initializeArticleImages();
</script>
