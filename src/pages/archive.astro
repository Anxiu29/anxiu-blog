---
import JournalLayout from '@/layouts/JournalLayout.astro';
import PostList from '@/components/journal/PostList.astro';
import BlogSidebar from '@/components/journal/BlogSidebar.astro';
import {getSortedPosts} from '@/utils/content-utils';
const posts=await getSortedPosts();
const categories=[...new Set(posts.map(p=>p.data.category).filter(Boolean))];
---
<JournalLayout title="文章与记录"><section class="page-intro"><h1>文章与记录</h1><p>把做过的事情写清楚，把有用的方法留下来。</p><nav class="browse-links" aria-label="文章浏览方式"><a href="/tags/">按标签阅读 →</a><a href="/categories/">浏览分类</a><a href="/rss/">订阅更新</a></nav></section><div class="blog-columns"><div class="archive-content"><form class="archive-filter" role="search"><label class="sr-only" for="archive-query">搜索文章</label><input id="archive-query" name="q" type="search" placeholder="搜索标题、摘要或标签"/><label class="sr-only" for="archive-category">文章分类</label><select id="archive-category" name="category"><option value="">全部分类</option>{categories.map(c=><option value={c}>{c}</option>)}</select><button type="reset">重置筛选</button></form><p id="archive-status" class="result-count" role="status" aria-live="polite">共 {posts.length} 篇文章</p><PostList posts={posts} filterable headingLevel="h2"/><p id="archive-empty" class="empty-state" hidden>没有匹配的文章，试试其他关键词或重置筛选。</p></div><BlogSidebar/></div></JournalLayout>
<script>
const form=document.querySelector<HTMLFormElement>('.archive-filter');const input=document.querySelector<HTMLInputElement>('#archive-query');const category=document.querySelector<HTMLSelectElement>('#archive-category');const rows=[...document.querySelectorAll<HTMLElement>('.post-row')];const status=document.querySelector('#archive-status');const empty=document.querySelector<HTMLElement>('#archive-empty');const params=new URLSearchParams(location.search);let tag=params.get('tag')||'';let missingCategory='';
if(input)input.value=params.get('q')||'';if(category){const requested=params.get('category')||'';category.value=requested;if(requested&&!category.value)missingCategory=requested;}
function filter(){let count=0;const query=input?.value.trim().toLocaleLowerCase()||'';for(const row of rows){const text=row.dataset.filterText?.toLocaleLowerCase()||'';const visible=text.includes(query)&&(!category?.value||row.dataset.category===category.value)&&!missingCategory&&(!tag||(row.dataset.tags||'').split('|').includes(tag));row.hidden=!visible;if(visible)count++;}if(status)status.textContent=tag?'标签「'+tag+'」 · '+count+' 篇文章':'共 '+count+' 篇文章';if(empty)empty.hidden=count>0;}
input?.addEventListener('input',filter);category?.addEventListener('change',()=>{missingCategory='';filter();});form?.addEventListener('submit',e=>e.preventDefault());form?.addEventListener('reset',()=>{tag='';missingCategory='';history.replaceState(null,'',location.pathname);requestAnimationFrame(filter);});filter();
</script>
