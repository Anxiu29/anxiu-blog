---
import type { GetStaticPaths, Page } from 'astro';
import LeftSidebar from '@/components/journal/LeftSidebar.astro';
import RightSidebar from '@/components/journal/RightSidebar.astro';
import CategoryBar from '@/components/journal/CategoryBar.astro';
import PostList from '@/components/journal/PostList.astro';
import Icon from '@/components/journal/Icon.astro';
import HomeFeatured from '@/components/journal/HomeFeatured.astro';
import JournalLayout from '@/layouts/JournalLayout.astro';
import { getSortedPosts, type PostForList } from '@/utils/content-utils';
export const getStaticPaths = (async({paginate})=>paginate(await getSortedPosts(),{pageSize:6})) satisfies GetStaticPaths;
const { page } = Astro.props as {page:Page<PostForList>};
---
<JournalLayout title={page.currentPage>1?`文章 · 第 ${page.currentPage} 页`:undefined} active="首页">
 <div class="journal-home-grid"><LeftSidebar/><div class="journal-feed"><CategoryBar/>
  {page.currentPage === 1 && <HomeFeatured/>}
  <nav class="home-reading-links" aria-label="阅读入口"><a href="/series/"><span class="life-icon"><Icon name="book"/></span><span><strong>循着专题读</strong><small>把相关的实践连起来</small></span><Icon name="chevron"/></a><a href="/todo/"><span class="life-icon"><Icon name="todo"/></span><span><strong>我的待办</strong><small>记下一件今天想做的事</small></span><Icon name="chevron"/></a></nav>
  <section class="recent-posts" aria-labelledby="posts-heading"><div class="feed-heading"><h2 id="posts-heading">文章与记录 <small>{page.total} 篇</small></h2><a href="/archive/">全部文章</a></div><PostList posts={page.data} headingLevel="h2"/>
  {page.lastPage>1&&<nav class="feed-pagination" aria-label="文章分页">{page.url.prev?<a href={page.url.prev} rel="prev" aria-label="上一页"><Icon name="left"/></a>:<span class="page-boundary" aria-hidden="true"><Icon name="left"/></span>}{Array.from({length:page.lastPage},(_,i)=>i+1).map(n=><a href={n===1?'/':`/${n}/`} aria-current={n===page.currentPage?'page':undefined} aria-label={`第 ${n} 页`}>{n}</a>)}{page.url.next?<a href={page.url.next} rel="next" aria-label="下一页"><Icon name="right"/></a>:<span class="page-boundary" aria-hidden="true"><Icon name="right"/></span>}<span>第 {page.currentPage} / {page.lastPage} 页</span></nav>}
  </section>
 </div><RightSidebar/></div>
</JournalLayout>
