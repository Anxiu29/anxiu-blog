---
import Icon from "@/components/journal/Icon.astro";
import JournalLayout from "@/layouts/JournalLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

const posts = (await getSortedPosts()).filter((post) => !post.data.password);
---
<JournalLayout title="我的收藏" description="把想读和想回看的文章留在本机收藏清单，按自己的节奏慢慢读。" active="文章" noindex>
 <section class="page-intro"><span class="saved-eyebrow">READ IT LATER</span><h1>想读的，慢慢读。</h1><p>在文章里点一下收藏，把值得回看的记录留在这里。</p></section>
 <section class="saved-collection" aria-label="本机文章收藏">
  <div class="saved-collection-heading"><p role="status" aria-live="polite" data-saved-status tabindex="-1">正在读取本机收藏…</p><a class="text-link" href="/archive/">发现更多文章 →</a></div>
  <div class="saved-empty j-card" data-saved-empty hidden><span><Icon name="book"/></span><h2>给下次阅读，留个位置。</h2><p>还没有收藏文章。读到想留住的内容时，点击阅读工具中的“收藏文章”。</p><a class="j-button primary" href="/archive/">去看看文章 <Icon name="right"/></a></div>
  <div class="saved-list" data-saved-list>{posts.map(post=><article class="saved-card j-card" data-saved-card={getPostUrlBySlug(post.id)} hidden><div><span class="saved-category">{post.data.category}</span><time datetime={post.data.published.toISOString()}>{post.data.published.toISOString().slice(0,10).replaceAll('-','.')}</time></div><h2><a href={getPostUrlBySlug(post.id)}>{post.data.title}</a></h2><p>{post.data.description}</p><div class="saved-card-actions"><a href={getPostUrlBySlug(post.id)}>继续阅读 →</a><button type="button" data-save-article={getPostUrlBySlug(post.id)} aria-pressed="false"><Icon name="check"/><span data-save-label>取消收藏</span></button></div></article>)}</div>
  <p class="saved-privacy">只保存文章地址和收藏时间，不保存正文、不上传，也不会跨设备同步。清除网站数据会清除收藏。</p><p class="saved-privacy" data-save-status role="status" aria-live="polite"></p>
  <noscript><p>本机收藏需要 JavaScript。你也可以直接<a href="/archive/">浏览所有文章</a>。</p></noscript>
 </section>
</JournalLayout>
