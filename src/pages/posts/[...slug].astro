---
import { type CollectionEntry, render } from "astro:content";
import Comment from "@/components/comment/index.astro";
import EncryptedPost from "@/components/features/EncryptedPost.astro";
import KatexManager from "@/components/features/KatexManager.astro";
import PostList from "@/components/journal/PostList.astro";
import ReadingTools from "@/components/journal/ReadingTools.astro";
import SeriesNavigation from "@/components/journal/SeriesNavigation.astro";
import { siteConfig } from "@/config/siteConfig";
import { series } from "@/data/blog-discovery";
import { getPostMedia } from "@/data/post-media";
import JournalLayout from "@/layouts/JournalLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@/utils/content-utils";
import { removeFileExtension } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
}
export async function getStaticPaths() {
	return (await getSortedPosts({ includeTemplateDemos: true })).map(
		(entry) => ({
			params: { slug: removeFileExtension(entry.id) },
			props: { entry },
		}),
	);
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ ...h, text: h.text.replace(/#$/, "") }));
const date = entry.data.published.toISOString().slice(0, 10);
const media = getPostMedia(entry.id);
const topic =
	!entry.data.templateDemo && !entry.data.password
		? series.find((s) => s.posts.includes(removeFileExtension(entry.id)))
		: undefined;
const related =
	!entry.data.templateDemo && !entry.data.password
		? await getRelatedPosts(entry, 2)
		: [];
---
<JournalLayout title={entry.data.title} description={entry.data.description} noindex={entry.data.templateDemo}>
  <KatexManager slot="head"/>
  <div class="article-layout">
    <article class="article-column">
      <nav class="article-breadcrumb" aria-label="面包屑"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/archive/">文章</a>{entry.data.category&&<><span aria-hidden="true">/</span><a href={'/archive/?category='+encodeURIComponent(entry.data.category)}>{entry.data.category}</a></>}</nav>
      <header class="article-header">
        <div class="article-meta">{entry.data.templateDemo?<span>原主题模板示例</span>:<><span>安秀</span><span aria-hidden="true">·</span><time datetime={date}>{date.replaceAll('-','.')}</time></>}</div>
        <h1>{entry.data.title}</h1><p class="article-description">{entry.data.description}</p>
        {!entry.data.templateDemo&&entry.data.tags.length>0&&<nav class="article-tags" aria-label="文章标签">{entry.data.tags.map(tag=><a href={'/archive/?tag='+encodeURIComponent(tag)}># {tag}</a>)}</nav>}
      </header>
      {!entry.data.templateDemo&&!entry.data.password&&<ReadingTools url={new URL(Astro.url.pathname,siteConfig.site_url).href}/>}
      {media&&!entry.id.startsWith('fog-town-nightwalk')&&<figure class="article-project-cover"><img src={media.src} alt={media.caption} width={media.width} height={media.height}/><figcaption>{media.caption}</figcaption></figure>}
      {toc.length>0&&<details class="mobile-toc"><summary>本文目录</summary><nav aria-label="本文目录">{toc.map(h=><a class:list={{nested:h.depth===3}} href={'#'+h.slug} data-toc-link>{h.text}</a>)}</nav></details>}
      {entry.data.password?<EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}><div class="article-body"><Content/></div></EncryptedPost>:<div class="article-body"><Content/></div>}
      {topic&&<a class="article-series-link" href={'/series/'+topic.slug+'/'}><span>所属专题</span><strong>{topic.title}</strong><span aria-hidden="true">→</span></a>}
      {!entry.data.templateDemo&&!entry.data.password&&<SeriesNavigation entryId={entry.id}/>}
      <footer class="article-end"><a href="/archive/">← 全部文章</a><a href="#top">返回顶部 ↑</a><a href="/rss/">订阅更新 →</a></footer>
      {related.length>0&&<section class="related-posts" aria-labelledby="related-heading"><div class="section-heading"><h2 id="related-heading">接着读</h2><a href="/archive/">全部文章 →</a></div><PostList posts={related}/></section>}
      {entry.data.comment&&<Comment post={entry}/>}
    </article>
    {toc.length>0&&<aside class="article-toc"><nav aria-label="本文目录"><h2>本文目录</h2>{toc.map(h=><a class:list={{nested:h.depth===3}} href={'#'+h.slug} data-toc-link>{h.text}</a>)}</nav><div class="article-author"><strong>安秀</strong><p>前端开发与设备联调</p><a href="/about/">关于作者 →</a></div></aside>}
  </div>
</JournalLayout>
<script>
const links=[...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
const headings=[...document.querySelectorAll<HTMLElement>('.article-body h2[id],.article-body h3[id]')];
let scheduled=false;
function updateToc(){
  const offset=(Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop)||110)+20;
  let current=headings[0]?.id;
  for(const heading of headings){if(heading.getBoundingClientRect().top<=offset)current=heading.id;else break;}
  for(const link of links){const selected=decodeURIComponent(link.hash.slice(1))===current;if(selected)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');}
  scheduled=false;
}
if(links.length){updateToc();document.addEventListener('scroll',()=>{if(!scheduled){scheduled=true;requestAnimationFrame(updateToc);}},{passive:true});window.addEventListener('resize',updateToc);}
</script>
