---
import BlogSidebar from "@/components/journal/BlogSidebar.astro";
import { series } from "@/data/blog-discovery";
import JournalLayout from "@/layouts/JournalLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";
export function getStaticPaths() {
	return series.map((topic) => ({
		params: { slug: topic.slug },
		props: { topic },
	}));
}
const { topic } = Astro.props;
const posts = (await getSortedPosts()).filter((p) => !p.data.password);
const entries = topic.posts
	.map((id) => posts.find((p) => p.id.replace(/\.[^.]+$/, "") === id))
	.filter((p): p is NonNullable<typeof p> => !!p);
---
<JournalLayout title={topic.title} active="逛逛"><section class="page-intro"><nav class="browse-links series-breadcrumb" aria-label="专题面包屑"><a href="/series/">专题阅读</a><span aria-hidden="true">/</span><span>{topic.title}</span></nav><h1>{topic.title}</h1><p>{topic.description}</p></section><div class="blog-columns"><section class="series-reading" aria-labelledby="reading-order"><h2 id="reading-order">阅读顺序 <small>{entries.length} 篇</small></h2><ol>{entries.map((post,index)=><li><span class="reading-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><div><span class="reading-kind">{post.data.category}</span><h3><a href={getPostUrlBySlug(post.id)}>{post.data.title}</a></h3><p>{post.data.description}</p></div></li>)}</ol><a class="text-link" href="/series/">← 全部专题</a></section><BlogSidebar/></div></JournalLayout>
